  @UI.fieldGroup: [{ qualifier: 'ToBe', position: 10 }]
  TgtSysId;

  @UI.hidden: true
  TgtSysText;

  @UI: {
    lineItem:       [{ position: 40 }],
    selectionField: [{ position: 30 }],
    fieldGroup:     [{ qualifier: 'ToBe', position: 20 }],
    textArrangement: #TEXT_ONLY
  }
  TobeType;

  @UI.hidden: true

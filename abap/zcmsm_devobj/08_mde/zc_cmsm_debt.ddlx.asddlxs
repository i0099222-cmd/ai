    description: { type: #STANDARD, value: 'DebtId' }
  },
  presentationVariant: [
    { sortOrder: [{ by: 'CreatedAt', direction: #DESC }], visualizations: [{ type: #AS_LINEITEM }] },
    { qualifier: 'Tab', sortOrder: [{ by: 'CreatedAt', direction: #DESC }], visualizations: [{ type: #AS_LINEITEM }] }
  ],
  selectionVariant: [{ qualifier: 'Tab', text: '기술부채' }],
  selectionPresentationVariant: [{ qualifier: 'Tab', text: '기술부채',
                                   presentationVariantQualifier: 'Tab', selectionVariantQualifier: 'Tab' }]
}
annotate entity ZC_CMSM_Debt with
{
  @UI.facet: [
    { id: 'Header', purpose: #HEADER, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Header', position: 10 },
    { id: 'Target', type: #FIELDGROUP_REFERENCE, label: '대상 오브젝트', targetQualifier: 'Target', position: 10 },
    { id: 'Std', type: #FIELDGROUP_REFERENCE, label: '비released 사용', targetQualifier: 'Std', position: 20 },
    { id: 'Judge', type: #FIELDGROUP_REFERENCE, label: '판단·개선', targetQualifier: 'Judge', position: 30 },
    { id: 'Admin', type: #FIELDGROUP_REFERENCE, label: '관리 정보', targetQualifier: 'Admin', position: 40 }
  ]
  @UI.hidden: true
  DebtUuid;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]

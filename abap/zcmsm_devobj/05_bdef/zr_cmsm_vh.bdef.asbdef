managed implementation in class zbp_r_cmsm_vh unique;
strict ( 2 );
with draft;

define behavior for ZR_CMSM_Vh alias ValueHelp
persistent table ztcmsm00200
draft table ztcmsm00200_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  // 구현 방식·올린 사람·올린 일시는 자동
  field ( readonly )
      VhUuid,
      VhId,
      VhImpl,
      TestBy,
      TestAt,
      CreatedBy,
      CreatedAt,
      LastChangedBy,
      LastChangedAt,
      LocalLastChangedAt;

  field ( numbering : managed )
      VhUuid;

  field ( mandatory )
      VhName,
      SapModule;

  create;
  update;
  delete;

  // 새 VH: 담당자 = 등록한 사람 / VH 이름 → 구현 방식 판별 / 파일 올리면 올린 사람·일시 / 저장할 때 VH- 채번
  determination setInitialValues on modify { create; }
  determination detectVhImpl     on modify { create; field VhName; }
  determination setTestInfo      on modify { field TestFile, TestFileName; }
  determination setVhId          on save   { create; }

  validation validateMandatory on save { create; field VhName, SapModule; }
  validation validateVhName    on save { create; field VhName, SysId; }
  validation validateTestFile  on save { field TestFile, TestFileName; }

  // 자동으로 채운 값이 화면에 바로 보이게
  side effects
  {
    field VhName   affects field VhImpl;
    field TestFile affects field TestBy, field TestAt;
  }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateMandatory;
    validation validateVhName;
    validation validateTestFile;
    validation ValueHelpSource~validateSource;
  }

  association _Src { create; with draft; }

  mapping for ztcmsm00200 corresponding;
}

define behavior for ZR_CMSM_VhSrc alias ValueHelpSource
persistent table ztcmsm00210
draft table ztcmsm00210_d
etag master LocalLastChangedAt
lock dependent by _Vh
authorization dependent by _Vh
{
  field ( readonly )
      SrcUuid,
      VhUuid,
      LocalLastChangedAt;

  field ( numbering : managed )
      SrcUuid;

  field ( mandatory )
      SrcKind,
      SrcName;

  update;
  delete;

  validation validateSource on save { create; field SrcKind, SrcName; }

  association _Vh { with draft; }

  mapping for ztcmsm00210 corresponding;
}

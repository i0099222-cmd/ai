managed implementation in class zbp_r_cmsm_req unique;
strict ( 2 );
with draft;

define behavior for ZR_CMSM_Req alias Request
persistent table ztcmsm00170
draft table ztcmsm00170_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  // 상태·사유·완료일은 액션으로만 바뀐다
  field ( readonly )
      ReqUuid,
      ReqId,
      ReqStatus,
      DoneDate,
      CloseReason,
      CreatedBy,
      CreatedAt,
      LastChangedBy,
      LastChangedAt,
      LocalLastChangedAt;

  field ( numbering : managed )
      ReqUuid;

  // 요청자: 요청(R)일 때 제목·내용·모듈·담당자 / 담당자: 진행 중(I)일 때 처리 내용·관련 번호
  field ( features : instance )
      Title,
      ReqText,
      SapModule,
      Assignee,
      ProcResult,
      RelNo;

  create;
  update ( features : instance );
  delete ( features : instance );

  // 상태 변경
  action ( features : instance ) acceptRequest   result [1] $self;
  action ( features : instance ) completeRequest result [1] $self;
  action ( features : instance ) rejectRequest   parameter ZA_CMSM_CloseReason result [1] $self;
  action ( features : instance ) cancelRequest   parameter ZA_CMSM_CloseReason result [1] $self;

  // 새 요청은 상태 R, 저장할 때 요청번호 채번, 변경 내용은 이력으로
  determination setInitialValues on modify { create; }
  determination setReqId         on save   { create; }
  determination recordHistory    on save   { create; field Title, ReqText, SapModule, Assignee, ReqStatus, ProcResult, RelNo; }

  validation validateMandatory on save { create; field Title, SapModule, Assignee; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateMandatory;
  }

  // 이력은 BO가 직접 쓴다 (사용자 생성 불가)
  association _Hist { internal create; with draft; }

  mapping for ztcmsm00170 corresponding;
}

define behavior for ZR_CMSM_ReqHist alias RequestHistory
persistent table ztcmsm00180
draft table ztcmsm00180_d
etag master LocalLastChangedAt
lock dependent by _Req
authorization dependent by _Req
{
  field ( readonly )
      HistUuid,
      ReqUuid,
      ChangedAt,
      ChangedBy,
      LocalLastChangedAt;

  field ( numbering : managed )
      HistUuid;

  // update/delete 없음 → 화면에서 읽기 전용. 요청을 지우면 같이 지워진다
  association _Req { with draft; }

  mapping for ztcmsm00180 corresponding;
}

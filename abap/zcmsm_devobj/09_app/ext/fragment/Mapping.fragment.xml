<!--
  매핑 상세 · '매핑' custom section (As-Is | To-Be 두 칸, 칸 안은 라벨·필드를 세로로)
  - 폼(ColumnLayout)은 칸 하나를 두 열에 걸쳐 그려서 '시스템·유형 | 오브젝트' 처럼 퍼질 수 있다.
    그래서 요청 내용 fragment 처럼 직접 쌓는다: Grid 두 칸(폰은 한 칸) + 칸마다 VBox 에 라벨·필드를 위아래로
  - macros:Field 는 편집 모드·수정 권한(feature control)·값 도움말·텍스트 표시를 FE 기본처럼 따른다
  - 구분 = 신규(N)면 As-Is 칸을 통째로 숨긴다 (mapAsisBox visible). 편집 중에 구분을 바꾸면 바로 보였다 사라진다
  - 필수 별표(*)는 이 방식에선 자동이 아니라 라벨의 required 로 직접 단다:
    As-Is 세 칸·To-Be 유형·오브젝트 = 편집 중일 때 (As-Is 는 신규면 칸째 안 보이니 따로 조건 없음)
  - 위치: webapp/ext/fragment/Mapping.fragment.xml  /  manifest template: "<앱 ID>.ext.fragment.Mapping"
-->
<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:macros="sap.fe.macros">
  <l:Grid id="mapGrid" defaultSpan="XL6 L6 M6 S12" hSpacing="2" vSpacing="1" width="100%">

    <!-- 신규(N)는 As-Is 가 없어서 칸째 숨긴다 -->
    <VBox id="mapAsisBox" width="100%" visible="{= ${MapKind} !== 'N' }">
      <Title id="mapAsisTitle" text="As-Is" level="H4"/>

      <Label id="mapAsisSysLabel" text="시스템" class="sapUiSmallMarginTop"
             required="{ui>/isEditable}"/>
      <macros:Field id="mapAsisSysField" metaPath="SrcSysId"/>

      <Label id="mapAsisTypeLabel" text="유형" class="sapUiSmallMarginTop"
             required="{ui>/isEditable}"/>
      <macros:Field id="mapAsisTypeField" metaPath="AsisType"/>

      <Label id="mapAsisNameLabel" text="오브젝트" class="sapUiSmallMarginTop"
             required="{ui>/isEditable}"/>
      <macros:Field id="mapAsisNameField" metaPath="AsisName"/>
    </VBox>

    <VBox id="mapTobeBox" width="100%">
      <Title id="mapTobeTitle" text="To-Be" level="H4"/>

      <Label id="mapTobeSysLabel" text="시스템" class="sapUiSmallMarginTop"/>
      <macros:Field id="mapTobeSysField" metaPath="TgtSysId"/>

      <Label id="mapTobeTypeLabel" text="유형" class="sapUiSmallMarginTop"
             required="{ui>/isEditable}"/>
      <macros:Field id="mapTobeTypeField" metaPath="TobeType"/>

      <Label id="mapTobeNameLabel" text="오브젝트" class="sapUiSmallMarginTop"
             required="{ui>/isEditable}"/>
      <macros:Field id="mapTobeNameField" metaPath="TobeName"/>
    </VBox>

  </l:Grid>
</core:FragmentDefinition>

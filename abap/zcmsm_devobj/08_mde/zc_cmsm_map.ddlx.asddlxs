@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: '매핑',
    typeNamePlural: '매핑',
    title:       { type: #STANDARD, value: 'TobeName' },
    description: { type: #STANDARD, value: 'MapId' }
  },
  presentationVariant: [
    { sortOrder: [{ by: 'CreatedAt', direction: #DESC }], visualizations: [{ type: #AS_LINEITEM }] },
    { qualifier: 'Tab', sortOrder: [{ by: 'CreatedAt', direction: #DESC }], visualizations: [{ type: #AS_LINEITEM }] }
  ],
  selectionVariant: [{ qualifier: 'Tab', text: 'As-Is/To-Be' }],
  selectionPresentationVariant: [{ qualifier: 'Tab', text: 'As-Is/To-Be',
                                   presentationVariantQualifier: 'Tab', selectionVariantQualifier: 'Tab' }]
}
// 상세 화면: 기본 정보 → 매핑(As-Is | To-Be 나란히) → UI 연결 → To-Be 데이터 소스(최하위까지) → 사용처(같은 패키지 CDS) → 관리 정보
//   매핑(As-Is | To-Be)은 MDE 가 아니라 앱의 custom section (ext/fragment/Mapping.fragment.xml, 기본 정보 뒤).
//   FE 기본 폼은 칸을 3~4개로 잡아 필드가 옆으로 퍼져서, 2칸 폼을 직접 만든다. 그래서 여기엔 As-Is·To-Be 필드그룹이 없다
annotate entity ZC_CMSM_Map with
{
  @UI.facet: [
    { id: 'Header',     purpose: #HEADER, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Header', position: 10 },
    { id: 'General',    type: #FIELDGROUP_REFERENCE, label: '기본 정보', targetQualifier: 'General', position: 10 },
    { id: 'Ui',         type: #FIELDGROUP_REFERENCE, label: 'UI 연결 (To-Be가 T-code일 때)', targetQualifier: 'Ui', position: 30 },
    { id: 'TobeSrc',    type: #LINEITEM_REFERENCE, label: 'To-Be 데이터 소스', targetElement: '_TobeSource', position: 35 },
    { id: 'Usage',      type: #LINEITEM_REFERENCE, label: '사용처 (같은 패키지 CDS)', targetElement: '_Usage', position: 40 },
    { id: 'Admin',      type: #FIELDGROUP_REFERENCE, label: '관리 정보', targetQualifier: 'Admin', position: 50 }
  ]
  @UI.hidden: true
  MapUuid;

  @UI.lineItem: [{ position: 10, importance: #HIGH },
                 { type: #FOR_ACTION, dataAction: 'uploadExcel', label: '엑셀 업로드' }]
  MapId;

  @UI: {
    lineItem:       [{ position: 20 }],
    selectionField: [{ position: 20 }],
    fieldGroup:     [{ qualifier: 'General', position: 10 },
                     { qualifier: 'Header', position: 10 }],
    textArrangement: #TEXT_ONLY
  }
  MapKind;

  @UI.hidden: true
  MapKindText;

  @UI.hidden: true
  SrcSysText;

  @UI.textArrangement: #TEXT_ONLY
  AsisType;

  @UI.hidden: true
  AsisTypeText;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  AsisName;

  @UI.hidden: true
  TgtSysText;

  @UI: {
    lineItem:       [{ position: 40 }],
    selectionField: [{ position: 30 }],
    textArrangement: #TEXT_ONLY
  }
  TobeType;

  @UI.hidden: true
  TobeTypeText;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  TobeName;

  @UI: {
    lineItem:       [{ position: 60 }],
    selectionField: [{ position: 40 }],
    fieldGroup:     [{ qualifier: 'Ui', position: 10 }],
    textArrangement: #TEXT_ONLY
  }
  UiKind;

  @UI.hidden: true
  UiKindText;

  @UI.fieldGroup: [{ qualifier: 'Ui', position: 20 }]
  FioriAppId;

  @UI.fieldGroup: [{ qualifier: 'Ui', position: 30 }]
  SemObjAction;

  @UI.fieldGroup: [{ qualifier: 'Ui', position: 40 }]
  ReactApp;

  @UI.fieldGroup: [{ qualifier: 'Ui', position: 50 }]
  UiUri;

  @UI: {
    lineItem:       [{ position: 70 }],
    selectionField: [{ position: 10 }],
    fieldGroup:     [{ qualifier: 'General', position: 20 },
                     { qualifier: 'Header', position: 20 }],
    textArrangement: #TEXT_ONLY
  }
  SapModule;

  @UI.hidden: true
  SapModuleText;

  @UI.fieldGroup: [{ qualifier: 'General', position: 30 }]
  Description;

  @UI: {
    lineItem:       [{ position: 80 }],
    selectionField: [{ position: 50 }],
    fieldGroup:     [{ qualifier: 'General', position: 40 },
                     { qualifier: 'Header', position: 30 }]
  }
  OwnerId;

  @UI.hidden: true
  OwnerName;

  @UI.fieldGroup: [{ qualifier: 'General', position: 50 }]
  ObjCreator;

  @UI.fieldGroup: [{ qualifier: 'General', position: 60 }]
  ReqId;

  @UI.hidden: true
  ReqTitle;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 40 }]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}

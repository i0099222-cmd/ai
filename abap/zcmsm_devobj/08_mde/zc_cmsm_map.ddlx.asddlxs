@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: '매핑',
    typeNamePlural: '매핑',
    title:       { type: #STANDARD, value: 'TobeName' },
    description: { type: #STANDARD, value: 'MapId' }
  },
  presentationVariant: [
    { sortOrder: [{ by: 'CreatedAt', direction: #DESC }], visualizations: [{ type: #AS_LINEITEM }] },
    { qualifier: 'Tab', sortOrder: [{ by: 'CreatedAt', direction: #DESC }], visualizations: [{ type: #AS_LINEITEM }] }
  ],
  selectionVariant: [{ qualifier: 'Tab', text: 'As-Is/To-Be' }],
  selectionPresentationVariant: [{ qualifier: 'Tab', text: 'As-Is/To-Be',
                                   presentationVariantQualifier: 'Tab', selectionVariantQualifier: 'Tab' }]
}
annotate entity ZC_CMSM_Map with
{
  @UI.facet: [
    { id: 'Header', purpose: #HEADER, type: #FIELDGROUP_REFERENCE, targetQualifier: 'Header', position: 10 },
    { id: 'AsIs', type: #FIELDGROUP_REFERENCE, label: 'As-Is', targetQualifier: 'AsIs', position: 10 },
    { id: 'ToBe', type: #FIELDGROUP_REFERENCE, label: 'To-Be', targetQualifier: 'ToBe', position: 20 },
    { id: 'Ui', type: #FIELDGROUP_REFERENCE, label: 'UI (T-code일 때)', targetQualifier: 'Ui', position: 30 },
    { id: 'General', type: #FIELDGROUP_REFERENCE, label: '기본 정보', targetQualifier: 'General', position: 40 },
    { id: 'Admin', type: #FIELDGROUP_REFERENCE, label: '관리 정보', targetQualifier: 'Admin', position: 50 }
  ]
  @UI.hidden: true
  MapUuid;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  MapId;

  @UI: {
    lineItem:       [{ position: 20 }],
    selectionField: [{ position: 20 }],
    fieldGroup:     [{ qualifier: 'AsIs', position: 10 },

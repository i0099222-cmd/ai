projection;
strict ( 2 );
use draft;

define behavior for ZDQ_P_TABLE_TO_BO_HEADER alias PurchaseOrder
{
  use create;
  use update;
  use delete;

  use action closeOrder;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZDQ_P_TABLE_TO_BO_ITEM alias PurchaseOrderItem
{
  use update;
  use delete;

  use association _Header { with draft; }
}

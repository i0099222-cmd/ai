<!--
  통합 조회 상세 · '관련 요청' custom section (읽기 전용)
  - 윗줄: '요청번호 : …' | '상태 : …' 를 Grid 칸 두 개에 (칸 폭이 고정이라 열이 항상 맞는다. 폰은 한 칸씩 아래로)
      HBox 로 나란히 두면 내용 길이대로 폭이 잡혀서, 공간이 애매하면 둘째 칸이 다음 줄로 들쭉날쭉 내려간다
  - 아래: 제목, 요청 내용을 세로로. 요청 내용은 섹션 폭을 다 쓰고 줄바꿈을 그대로 보여 준다
  - 값은 ZC_CMSM_DevObject 필드에 바로 바인딩: ReqId, ReqStatus·ReqStatusText(상태는 코드 말고 텍스트), ReqTitle, ReqText, ReqHidden
  - 연결된 요청이 없는 행(기술부채, 요청 없이 등록한 건)은 '연결된 요청이 없습니다.'만 보인다
  - 위치: webapp/ext/fragment/DevObjectRequest.fragment.xml  /  manifest template: "<앱 ID>.ext.fragment.DevObjectRequest"
-->
<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
  <VBox id="devReqBox" width="100%">

    <Text id="devReqEmpty" text="연결된 요청이 없습니다."
          visible="{= ${ReqHidden} === true }"/>

    <VBox id="devReqContent" width="100%" visible="{= ${ReqHidden} !== true }">

      <!-- 윗줄: 요청번호 | 상태 — 칸 폭 고정 (넓은 화면 1/4씩, 태블릿 반반, 폰 한 줄씩)
           hSpacing 0: 간격을 주면 첫 칸 왼쪽에도 여백이 생겨 아래 제목과 시작선이 어긋난다 -->
      <l:Grid id="devReqTopGrid" defaultSpan="XL3 L3 M6 S12" hSpacing="0" vSpacing="0" width="100%">
        <HBox id="devReqIdBox" alignItems="Center">
          <Label id="devReqIdLabel" text="요청번호" showColon="true" labelFor="devReqId" class="sapUiTinyMarginEnd"/>
          <Text id="devReqId" text="{ReqId}"/>
        </HBox>
        <HBox id="devReqStatusBox" alignItems="Center">
          <Label id="devReqStatusLabel" text="상태" showColon="true" labelFor="devReqStatus" class="sapUiTinyMarginEnd"/>
          <ObjectStatus id="devReqStatus" text="{ReqStatusText}"
                        state="{= ${ReqStatus} === 'C' ? 'Success'
                                : ${ReqStatus} === 'J' ? 'Error'
                                : ${ReqStatus} === 'X' ? 'Warning'
                                : ${ReqStatus} === 'I' ? 'Information' : 'None' }"/>
        </HBox>
      </l:Grid>

      <!-- 아래: 제목, 요청 내용 (라벨 위·값 아래) -->
      <Label id="devReqTitleLabel" text="제목" labelFor="devReqTitle" class="sapUiSmallMarginTop"/>
      <Text id="devReqTitle" text="{ReqTitle}"/>

      <Label id="devReqTextLabel" text="요청 내용" labelFor="devReqText" class="sapUiSmallMarginTop"/>
      <Text id="devReqText" text="{ReqText}" wrapping="true" renderWhitespace="true"/>
    </VBox>

  </VBox>
</core:FragmentDefinition>

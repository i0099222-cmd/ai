/*
 * 예시: 기존 TADIR 래핑 RAP BO(오브젝트 조회 앱, draft 사용)에 동적 업로드를 추가하는 스니펫.
 *
 * 엔터티 키는 TADIR 주키와 동일하다고 본다:
 *   PgmId (TADIR-PGMID) / Object (TADIR-OBJECT) / ObjName (TADIR-OBJ_NAME)
 *
 * ---------------------------------------------------------------------------
 * 구조가 왜 이렇게 되는가
 * ---------------------------------------------------------------------------
 * TADIR은 읽기 전용 SAP 표준 테이블이라 업로드 파일을 담을 수 없다.
 * managed BO는 "엔터티 1개 = persistent table 1개"이므로, TADIR 엔터티에
 * 스테이징 테이블의 필드를 직접 쓰기 가능하게 만들 수는 없다.
 *
 *   TadirObject (persistent table = tadir,               읽기 전용)
 *     └─ Staging (persistent table = ztb_dyn_upload_stg,  쓰기 가능)
 *
 * draft를 쓰므로 두 엔터티 모두 draft 테이블이 필요하다(루트가 읽기 전용이어도 예외 없음).
 *
 * ---------------------------------------------------------------------------
 * draft에서 특히 주의할 점: uploadData의 실행 시점
 * ---------------------------------------------------------------------------
 * uploadData는 대상 CBO 테이블에 **직접 Open SQL MODIFY**를 날린다. 이건 RAP 트랜잭션
 * 버퍼를 거치지 않으므로, draft 상태에서 실행한 뒤 사용자가 Discard를 눌러도
 * 이미 들어간 데이터는 되돌아가지 않는다.
 *
 * 그래서 uploadData는 **활성(active) 인스턴스에서만** 실행되도록 feature control로 막는다.
 * 사용자 흐름: 편집 → 파일 첨부 → 저장(활성화) → uploadData 실행.
 * (lhc_tadirobject~get_instance_features 의 %is_draft 검사 참고)
 *
 * generateTemplate은 EML로 RAP 관리 데이터만 쓰므로 draft에서 실행해도 안전하다.
 * ---------------------------------------------------------------------------
 */

managed implementation in class zbp_i_tadirobject unique;
strict ( 2 );
with draft;

define behavior for ZI_TadirObject alias TadirObject
persistent table tadir
// 이미 draft를 쓰고 있다면 루트 draft 테이블은 기존 것을 그대로 쓴다(신규 생성 불필요).
draft table <기존_루트_draft_테이블>
// total etag 필드도 기존에 쓰던 것을 그대로 두면 된다.
// 없다면 스테이징의 last_changed_at을 끌어올려 쓴다(view_additions 스니펫 참고).
lock master total etag LastChangedAt
authorization master ( instance )
// TADIR 자체는 절대 쓰지 않으므로 create/update/delete를 선언하지 않는다.
{
  field ( readonly ) PgmId, Object, ObjName;

  // 스테이징 자식. draft BO이므로 with draft 가 필요하다.
  association _Staging { create; with draft; }

  /* -------------------------------------------------------------------------
   * 동적 업로드 액션 2종.
   *
   * features : instance 필수. TADIR에는 PROG/CLAS/DDLS 등이 대부분이고
   * OBJECT = 'TABL' 인 행에도 구조체(TABCLASS = INTTAB)가 섞여 있어서,
   * 게이팅이 없으면 모든 행에서 버튼이 활성화된다.
   * ------------------------------------------------------------------------- */

  // 템플릿 생성: 대상 테이블 구조로 Excel 템플릿을 만들어 Staging-TemplateFile에 넣는다.
  // 생성 후 사용자는 그 스트림 필드의 다운로드 링크($value)로 내려받는다.
  action ( features : instance ) generateTemplate result [1] $self;

  // 업로드 실행: Staging-UploadFile에 올라온 파일로 마이그레이션을 수행한다.
  // draft 상태에서는 비활성화된다(위 주석 참고).
  action ( features : instance ) uploadData result [1] $self;

  /* draft 표준 액션 */
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare { }
}

define behavior for ZI_DynUploadStaging alias Staging
persistent table ztb_dyn_upload_stg
draft table ztb_dyn_upl_stg_d
lock dependent by _TadirObject
authorization dependent by _TadirObject
{
  update;
  delete;
  association _TadirObject { with draft; }

  field ( readonly ) PgmId, Object, ObjName;

  // 템플릿은 액션만 채운다. 사용자가 직접 올리지 못하게 막는다.
  field ( readonly ) TemplateFile, TemplateFileName, TemplateFileMimeType;

  // 실행 결과 요약도 액션이 채우는 값이다.
  field ( readonly ) LastTotalRows, LastSuccessRows, LastErrorRows, LastRunAt;

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  mapping for ztb_dyn_upload_stg
    {
      PgmId                = pgmid;
      Object               = object;
      ObjName              = obj_name;
      UploadFile           = upload_file;
      UploadFileName       = upload_filename;
      UploadFileMimeType   = upload_mimetype;
      TemplateFile         = template_file;
      TemplateFileName     = template_filename;
      TemplateFileMimeType = template_mimetype;
      LastTotalRows        = last_total_rows;
      LastSuccessRows      = last_success_rows;
      LastErrorRows        = last_error_rows;
      LastRunAt            = last_run_at;
      CreatedBy            = created_by;
      CreatedAt            = created_at;
      LastChangedBy        = last_changed_by;
      LastChangedAt        = last_changed_at;
      LocalLastChangedAt   = local_last_changed_at;
    }
}

/* =====================================================================
 * Projection behavior (ZC_TadirObject 용)
 * =====================================================================
 *
 * projection;
 * strict ( 2 );
 * use draft;
 *
 * define behavior for ZC_TadirObject alias TadirObject
 * {
 *   use action generateTemplate;
 *   use action uploadData;
 *
 *   use action Edit;
 *   use action Activate;
 *   use action Discard;
 *   use action Resume;
 *   use action Prepare;
 *
 *   use association _Staging { create; with draft; }
 * }
 *
 * define behavior for ZC_DynUploadStaging alias Staging
 * {
 *   use update;
 *   use delete;
 *   use association _TadirObject { with draft; }
 * }
 */

  @UI: {
    fieldGroup:     [{ qualifier: 'Std', position: 10 }],
    multiLineText: true
  }
  DebtDesc;

  @UI: {
    lineItem:       [{ position: 50, importance: #HIGH }],
    selectionField: [{ position: 20 }],
    fieldGroup:     [{ qualifier: 'Judge', position: 10 },

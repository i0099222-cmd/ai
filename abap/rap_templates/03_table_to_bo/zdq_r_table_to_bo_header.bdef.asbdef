managed implementation in class zbp_dq_r_table_to_bo_header unique;
strict ( 2 );

define behavior for ZDQ_R_TABLE_TO_BO_HEADER alias OrderHeader
persistent table zdq_tordhdr
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  association _Item { create; }

  // 기술 키는 프레임워크가 생성, 업무 키는 저장 시 채번
  field ( numbering : managed, readonly ) OrderUUID;
  field ( mandatory : create ) OrderDate, Supplier, Plant, Currency;
  // 총액은 아이템 합계로 자동 계산, 상태는 액션으로만 변경
  field ( readonly ) OrderId, OrderStatus, TotalAmount,
                     CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  action closeOrder result [1] $self;

  validation checkSupplier on save { create; field Supplier; }

  determination setOrderNumber on save { create; }

  mapping for zdq_tordhdr
  {
    OrderUUID          = orderuuid;
    OrderId            = orderid;
    OrderDate          = orderdate;
    Supplier           = supplier;
    Plant              = plant;
    Currency           = currency;
    TotalAmount        = totalamount;
    OrderStatus        = orderstatus;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZDQ_R_TABLE_TO_BO_ITEM alias OrderItem
persistent table zdq_torditm
lock dependent by _Header
authorization dependent by _Header
etag master LocalLastChangedAt
{
  update;
  delete;
  association _Header;

  // ItemUUID 는 프레임워크가, OrderUUID 는 부모 association 이 채운다
  field ( numbering : managed, readonly ) ItemUUID;
  field ( readonly ) OrderUUID, ItemNo,
                     CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory ) Product, Quantity, QuantityUnit, Currency;

  // 아이템 번호 자동 부여 + 헤더 총액 재계산
  determination setItemNumber   on save { create; }
  determination calcTotalAmount on save { create; update; delete; }

  mapping for zdq_torditm
  {
    ItemUUID           = itemuuid;
    OrderUUID          = orderuuid;
    ItemNo             = itemno;
    Product            = product;
    Quantity           = quantity;
    QuantityUnit       = quantityunit;
    NetAmount          = netamount;
    Currency           = currency;
    DeliveryDate       = deliverydate;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

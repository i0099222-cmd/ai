managed implementation in class zbp_r_cmsm_sb unique;
strict ( 2 );
with draft;

define behavior for ZR_CMSM_Sb alias ODataService
persistent table ztcmsm00220
draft table ztcmsm00220_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( readonly )
      SbUuid,
      SbId,
      TestBy,
      TestAt,
      CreatedBy,
      CreatedAt,
      LastChangedBy,
      LastChangedAt,
      LocalLastChangedAt;


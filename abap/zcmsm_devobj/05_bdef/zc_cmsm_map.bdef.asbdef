projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_CMSM_Map alias Mapping
use etag
{
  use create;
  use update;
  use delete;

  use action uploadExcel;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Comp { create; with draft; }
}

define behavior for ZC_CMSM_MapComp alias MappingComponent
use etag
{
  use update;
  use delete;

  use association _Map { with draft; }
}
